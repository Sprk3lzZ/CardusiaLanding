# Clé API Resend (https://resend.com) — sans clé, les emails sont loggés en console
RESEND_API_KEY=

# Expéditeur (doit être un domaine vérifié sur Resend, ou onboarding@resend.dev en test)
NEWSLETTER_FROM="Cardusia <onboarding@resend.dev>"

# Destinataire de la notification à chaque inscription
NOTIFY_EMAIL=zeghiche@gmail.com

# Mot de passe du backoffice /admin
ADMIN_PASSWORD=change-me

# Secret pour signer le cookie de session admin (chaîne aléatoire longue)
SESSION_SECRET=change-me-to-a-long-random-string

# Dossier de la base SQLite (par défaut ./data)
DATA_DIR=./data
